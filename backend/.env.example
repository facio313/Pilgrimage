SECRET_KEY=replace-with-a-django-secret
POSTGRES_DB=pilgrimage
POSTGRES_USER=pilgrimage
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
PILGRIMAGE_SSO_ENABLED=false
# Rootless production Compose: absolute host path to a cks:cks mode-0640 regular file.
PILGRIMAGE_SSO_EDGE_SECRET_HOST_FILE=
# Direct backend runs only: path visible to the Django process.
PILGRIMAGE_SSO_EDGE_SECRET_FILE=
# Development fallback only. Must be at least 32 printable ASCII bytes.
PILGRIMAGE_SSO_EDGE_SECRET=
